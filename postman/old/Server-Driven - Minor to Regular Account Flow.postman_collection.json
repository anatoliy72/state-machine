							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"data\": {\n    \"accountDetails\": {\n      \"accountNumber\": \"999999\",\n      \"branchCode\": \"999\",\n      \"bankId\": \"99\",\n      \"accountType\": \"חשבון לא קיים\"\n    }\n  }\n}"
						},
