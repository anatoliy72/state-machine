{
	"info": {
		"_postman_id": "f9a4d697-4e7a-47ea-89a3-239e51d77e17",
		"name": "Server-Driven - Minor to Regular Account Flow",
		"description": "Server-driven API tests for Minor to Regular account conversion process (no client event).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "25875261",
		"_collection_link": "https://poalim.postman.co/workspace/state-machine~d98beaee-b391-4d06-9919-82a085a6b624/collection/25875261-f9a4d697-4e7a-47ea-89a3-239e51d77e17?action=share&source=collection_link&creator=25875261"
	},
	"item": [
		{
			"name": "01 - Happy Path Flow",
			"item": [
				{
					"name": "1.1 - Start Process (auto-advance to INCOME_SCREEN)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.response.code === 200);",
									"const r = pm.response.json();",
									"pm.test('Process created', () => {",
									"  pm.expect(r.id).to.exist;",
									"  pm.expect(r.type).to.eql('MINOR_TO_REGULAR');",
									"});",
									"pm.collectionVariables.set('processId_srv', r.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"clientId\": \"minor-123\",\n  \"type\": \"MINOR_TO_REGULAR\",\n  \"data\": {\n    \"minorAccountId\": \"MINOR-ACC-123\",\n    \"customerName\": \"יוסף כהן\",\n    \"branchCode\": \"IL-TLV-001\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/process/start",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"process",
								"start"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.2 - Submit Income (server-driven -> PERFORM_MATCH)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.code === 200);",
									"const r = pm.response.json();",
									"pm.test('Moved to PERFORM_MATCH', () => pm.expect(r.state).to.eql('PERFORM_MATCH'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"data\": {\n    \"currentIncome\": 5000,\n    \"incomeSource\": \"משכורת קבועה\",\n    \"employerName\": \"חברת הייטק בע״מ\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/process/{{processId_srv}}/advance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"process",
								"{{processId_srv}}",
								"advance"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.3 - Perform Document Match (-> WELCOME)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.code === 200);",
									"const r = pm.response.json();",
									"pm.test('Reached WELCOME', () => pm.expect(r.state).to.eql('WELCOME'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"data\": {\n    \"accountDetails\": {\n      \"accountNumber\": \"1234567\",\n      \"branchCode\": \"123\",\n      \"bankId\": \"12\",\n      \"accountType\": \"חשבון צעיר\"\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/process/{{processId_srv}}/advance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"process",
								"{{processId_srv}}",
								"advance"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.4 - Complete Welcome (idempotent stay in WELCOME)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.code === 200);",
									"const r = pm.response.json();",
									"pm.test('Stays in WELCOME', () => pm.expect(r.state).to.eql('WELCOME'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"data\": {}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/process/{{processId_srv}}/advance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"process",
								"{{processId_srv}}",
								"advance"
							]
						}
					},
					"response": []
				}
			]
		},
