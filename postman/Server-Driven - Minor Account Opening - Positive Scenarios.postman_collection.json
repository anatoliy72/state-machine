				{
					"name": "1.1 - Start Process",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => { pm.response.to.have.status(200); });",
									"const res = pm.response.json();",
									"pm.test('Process ID exists', () => { pm.expect(res.id).to.exist; pm.collectionVariables.set('processId_positive', res.id); });",
									"pm.test('Initial state is MINOR_OCCUPATION_SCREEN', () => { pm.expect(res.state).to.eql('MINOR_OCCUPATION_SCREEN'); });",
									"pm.test('Type is MINOR', () => { pm.expect(res.type).to.eql('MINOR'); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"clientId\": \"קטין-001\",\n  \"type\": \"MINOR\",\n  \"data\": {\n    \"customerName\": \"יוסף כהן\",\n    \"age\": 16,\n    \"parentName\": \"אברהם כהן\",\n    \"parentId\": \"123456789\"\n  }\n}"
