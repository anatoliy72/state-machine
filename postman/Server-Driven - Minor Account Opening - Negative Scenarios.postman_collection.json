					"response": []
				},
				{
					"name": "2.6 - Process Speech to Text (NEGATIVE - BLOCKED)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.code === 200);",
									"const r = pm.response.json();",
									"pm.test('Blocked state reached', () => pm.expect(r.state).to.eql('BLOCKED'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"data\": {\n    \"audioFile\": \"הקלטה-חשודה.wav\",\n    \"transcription\": \"אני חושב שיש כאן חשד לפעילות מסוכנת ולא חוקית\",\n    \"voiceScore\": 0.45,\n    \"blockReason\": \"זוהה תוכן חשוד בהקלטה - נדרשת בדיקה ידנית\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/process/{{processId_srv_minor_neg}}/advance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"process",
								"{{processId_srv_minor_neg}}",
								"advance"
							]
						}
					},
					"response": []
				},
				{
					"name": "2.7 - Verify Blocked State",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.code === 200);",
									"const r = pm.response.json();",
									"pm.test('Still BLOCKED', () => pm.expect(r.state).to.eql('BLOCKED'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/process/{{processId_srv_minor_neg}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"process",
								"{{processId_srv_minor_neg}}"
							]
						}
					},
					"response": []
				}
			]
		}
