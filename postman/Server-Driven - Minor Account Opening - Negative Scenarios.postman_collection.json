				{
					"name": "2.5 - Generate Document Scan (-> SPEECH_TO_TEXT)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"data\": {\n    \"documentType\": \"תעודת זהות\",\n    \"documentNumber\": \"987654321\",\n    \"scanQuality\": \"נמוכה\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/process/{{processId_srv_minor_neg}}/advance",
							"host": [
