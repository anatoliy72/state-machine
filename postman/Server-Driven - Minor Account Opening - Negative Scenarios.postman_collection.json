						"body": {
							"mode": "raw",
							"raw": "{\n  \"data\": {\n    \"monthlyIncome\": 400,\n    \"incomeSource\": \"דמי כיס מההורים\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/process/{{processId_srv_minor_neg}}/advance",
							"host": [
